# Server configuration
PORT=8000
HOST=0.0.0.0
# Set false to review only when someone posts /review on a PR.
AUTO_REVIEW=false
WEBHOOK_SECRET=your_github_webhook_secret_here

# GitHub integration
GITHUB_TOKEN=ghp_your_github_personal_access_token_or_app_token

# OpenAI or a provider with an OpenAI-compatible Chat Completions API
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL_NAME=gpt-4o
LLM_TEMPERATURE=0.2

# For Ollama: set LLM_PROVIDER=ollama, LLM_API_KEY=ollama,
# LLM_MODEL_NAME to a model you have pulled, and LLM_BASE_URL to:
# http://host.docker.internal:11434/v1 (Docker)
# http://localhost:11434/v1 (native)

# Optional limits
HTTP_TIMEOUT=30
LLM_TIMEOUT=120
MAX_WEBHOOK_BYTES=2000000
MAX_DIFF_BYTES=100000
MAX_CONCURRENT_REVIEWS=4